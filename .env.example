# Server-only settings. Never commit actual credentials.
# openai (default), wawazz, or deepseek. Destinations are fixed on the server.
AI_PROVIDER=deepseek
# openai / wawazz only: supply the selected provider's key (legacy variable name).
OPENAI_API_KEY=
# Used only when AI_PROVIDER=openai.
OPENAI_MODEL=gpt-4o-mini
# Used only when AI_PROVIDER=wawazz. Independent speech service is not yet configured.
WAWAZZ_MODEL=gpt-5.6-terra
# deepseek only: an independent official key is required, with no fallback to OPENAI_API_KEY.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Independent speech service: doubao, openai, or none.
# Unset preserves OpenAI speech only for AI_PROVIDER=openai; otherwise speech stays off.
TTS_PROVIDER=doubao
# Doubao speech console v3 key (not an Ark text-model key), required for TTS_PROVIDER=doubao.
DOUBAO_TTS_API_KEY=
DOUBAO_TTS_VOICE=ICL_uranus_en_male_alastor_tob
# Required for explicit OpenAI speech when the text provider is not openai.
OPENAI_TTS_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
